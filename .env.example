# =============================================================================
# Adaptive MLOps - Vulnerability Detection & Risk Prioritization
# Environment Configuration Template
# Copy to .env and fill in your values. Never commit .env to Git.
# =============================================================================

# --- Project ---
PROJECT_NAME=vulnerability-mlops
ENVIRONMENT=development   # development | staging | production
LOG_LEVEL=INFO

# --- NVD API ---
NVD_API_KEY=                        # Optional but recommended for higher rate limits
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_REQUESTS_PER_30S=5              # 5 without key, 50 with key
NVD_LOOKBACK_DAYS=30                # Days of history to pull on each run

# --- CISA KEV ---
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# --- EPSS ---
EPSS_API_URL=https://api.first.org/data/v1/epss

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vuln_mlops
POSTGRES_USER=mlops_user
POSTGRES_PASSWORD=mlops_secure_pass_change_me
DATABASE_URL=postgresql://mlops_user:mlops_secure_pass_change_me@postgres:5432/vuln_mlops

# --- Redis (Airflow broker / cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass_change_me
REDIS_URL=redis://:redis_secure_pass_change_me@redis:6379/0

# --- MinIO (S3-compatible artifact store) ---
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_pass_change_me
MINIO_BUCKET_NAME=mlops-artifacts
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_secure_pass_change_me

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=vulnerability-severity-prediction
MLFLOW_REGISTRY_URI=http://mlflow:5000
CHAMPION_MODEL_NAME=vulnerability-severity-classifier
CHALLENGER_MODEL_NAME=vulnerability-severity-challenger

# --- Airflow ---
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here_generate_with_python
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://mlops_user:mlops_secure_pass_change_me@postgres:5432/airflow_db
AIRFLOW__CELERY__BROKER_URL=redis://:redis_secure_pass_change_me@redis:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://mlops_user:mlops_secure_pass_change_me@postgres:5432/airflow_db
AIRFLOW__WEBSERVER__SECRET_KEY=airflow_secret_key_change_me
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=False
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_change_me
AIRFLOW_ADMIN_EMAIL=admin@vulnerability-mlops.local

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_SECRET_KEY=fastapi_secret_key_change_me
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Model Configuration ---
MODEL_INFERENCE_TIMEOUT_MS=500
CHAMPION_TRAFFIC_SPLIT=0.9        # 90% to champion, 10% to challenger
ENABLE_SHADOW_MODE=true

# --- Quality Gates ---
QUALITY_GATE_MIN_MACRO_F1=0.70
QUALITY_GATE_MIN_CRITICAL_RECALL=0.85
QUALITY_GATE_MAX_ECE=0.10
QUALITY_GATE_MAX_LATENCY_P99_MS=500
QUALITY_GATE_DRIFT_THRESHOLD=0.15

# --- Risk Scoring Weights (must sum to 1.0) ---
RISK_WEIGHT_CVSS=0.30
RISK_WEIGHT_KEV=0.25
RISK_WEIGHT_EPSS=0.20
RISK_WEIGHT_ASSET_CRITICALITY=0.15
RISK_WEIGHT_EXPOSURE=0.07
RISK_WEIGHT_MODEL_CONFIDENCE=0.03

# --- Monitoring ---
EVIDENTLY_REFERENCE_WINDOW_DAYS=30
DRIFT_CHECK_SCHEDULE=0 6 * * *     # Daily at 6 AM UTC
RETRAIN_SCHEDULE=0 2 * * 0         # Sunday 2 AM UTC

# --- Dashboard ---
DASHBOARD_PORT=8080
